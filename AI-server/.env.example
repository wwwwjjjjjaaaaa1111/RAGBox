# Required for ingestion / 入库必填: Zhipu embedding key used for knowledge ingestion
ZHIPUAI_API_KEY=

# Optional / 可选: 自定义向量模型（OpenAI 兼容端点，如 OpenRouter / 硅基流动 / 智谱 v4）。
# 填写 EMBEDDING_API_KEY 后优先使用该项；仅填 ZHIPUAI_API_KEY 时走智谱默认逻辑。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=embedding-3
# Optional, has default / 可选，有默认值: embedding output dimensions (MRL models like Qwen3). Empty = model default
EMBEDDING_DIMENSIONS=

# Optional, has default / 可选，默认 http://127.0.0.1:3001/v1: Node backend callback base url
NODE_BASE_URL=http://127.0.0.1:3001/v1

# Optional, but must match backend if enabled / 可选，若启用需与 backend 保持一致
AI_SERVICE_SHARED_SECRET=

# Optional, has default / 可选，有默认值: Qdrant vector store settings
# 本地开发默认连接 compose 启动的 qdrant；容器内由 compose 的 QDRANT_URL 环境变量覆盖。
QDRANT_URL=http://127.0.0.1:6333
VECTOR_COLLECTION_NAME=knowledge_chunks

# Optional, has defaults / 可选，有默认值: Ingestion settings
INGEST_CHUNK_SIZE=800
INGEST_CHUNK_OVERLAP=120
EMBEDDING_BATCH_SIZE=64
NODE_CALLBACK_TIMEOUT_SECONDS=10

# Required for chat / 聊天必填: Chat model settings
OPENAI_API_KEY=
# Recommended to fill explicitly / 建议显式填写，避免依赖服务端默认模型
OPENAI_CHAT_MODEL=
# Optional if provider SDK already has a default base URL / 若服务商 SDK 自带默认地址，可留空
OPENAI_BASE_URL=

# Optional, has defaults / 可选，有默认值: Retrieval settings
CHAT_RETRIEVAL_TOP_K=5
CHAT_RETRIEVAL_SCORE_THRESHOLD=0.35
CHAT_CONTEXT_MESSAGE_LIMIT=12

# Optional, has default / 可选，默认开启: 多轮对话检索改写（把指代型问题改写成独立检索词，失败自动回退）
QUERY_REWRITE_ENABLED=1

# Optional, has default / 可选，默认开启: 聊天工具调用（图表生成等）；模型不支持时运行中自动降级
CHAT_TOOLS_ENABLED=1

# Optional, has defaults / 可选，有默认值: 生成图表的输出目录与保留时长（分钟；0=永久保留，默认 0）
CHARTS_OUTPUT_DIRECTORY=
CHARTS_TTL_MINUTES=0

# Optional app config / 可选服务配置
HOST=127.0.0.1
PORT=8000