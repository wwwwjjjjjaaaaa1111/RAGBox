# Required / 必填: RAGBox backend API base URL (Node 服务的 /v1 前缀)
RAGBOX_API_URL=http://127.0.0.1:3001/v1

# Required / 必填: personal access token, generated on the RAGBox web UI "外部接入" section
# 在网页「模型设置 → 外部接入」生成，形如 ragbox_pat_xxxxxxxx
RAGBOX_TOKEN=

# Optional, has default / 可选，默认 15000: request timeout in milliseconds
RAGBOX_TIMEOUT_MS=15000

# Optional, has default / 可选，默认 120000: streaming chat timeout in milliseconds
# RAG 回答可能生成较久，单独给一个更宽的上限
RAGBOX_STREAM_TIMEOUT_MS=120000
